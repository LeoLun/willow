{
  "name": "willow",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter ./apps/work run dev",
    "lint": "oxlint apps/ packages/",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "shadcn-vue": "^2.6.2",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{css,json}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0",
  "pnpm": {
    "overrides": {
      "@earendil-works/pi-agent-core@0.80.6>@earendil-works/pi-ai": "0.84.4"
    },
    "patchedDependencies": {
      "@earendil-works/pi-agent-core@0.80.6": "patches/@earendil-works__pi-agent-core@0.80.6.patch"
    }
  }
}
